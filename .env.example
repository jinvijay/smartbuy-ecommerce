# Connection string from your Neon project dashboard (Connection Details).
# Use the pooled connection string for the app; either works for seeding.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Port the Express server listens on (also serves the built frontend in production)
PORT=3001

# Random secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The origin this server is reachable at (used for cookies and auth links)
BETTER_AUTH_URL=http://localhost:3001
